{
  "manifest_version": 3,
  "name": "LinkedIn Sem Feed",
  "version": "1.1.0",
  "description": "Esconde a timeline do feed do LinkedIn (/feed). Mantém notificações, mensagens, vagas e perfil.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "css": ["hide.css"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "action": { "default_popup": "popup.html", "default_title": "LinkedIn Sem Feed" }
}
